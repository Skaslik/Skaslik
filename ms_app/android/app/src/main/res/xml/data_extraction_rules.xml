<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of МС goes to Google backup or to a new phone.
     Only ciphertext may leave the device (I2), and the local replicas are
     plain JSON. Recovery is the recovery sheet plus sync. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
